;---------------------------------------------------------------------------
; 月華の剣士 第二幕 嘉神慎之介
;---------------------------------------------------------------------------
;変数使用表var
;　1 = 
;　2 = 剣質判別 (0.力　1.技　2.極)
;　3 = 起き上がり無敵付加判別
;　4 = ヒット数算出
;　5 = ステート内の自由変数１
;　6 = ステート内の自由変数２（紅蓮朱雀振り向き）
;　7 = 空中受身可能時間算出
;　8 = ステート奪取確認
;　9 = 勝利音判定
; 10 = プレイヤーの向き設定
; 11 = 連殺斬発動
; 12 = KOボイス
; 13 = 永久防止１
; 14 = 永久防止２
; 15 = 小ジャンプ (0.ノーマル　1.小)
; 16 = 静かなる鼓動ゲージ回収
; 17 = 相手弾かれ状態判定
; 18 = ガード硬直短縮判定
; 19 = ガード硬直短縮用HitTime記憶
; 20 = 降炎襲ヒット判定
; 21 = 弾き成立カウンター判定
; 22 = 完全勝利判定
; 23 = 根性値初撃用体力常時監視
; 24 = 根性値初撃用状態監視
; 25 = 
; 26 = 
; 27 = 
; 28 = 
; 29 = 
; 30 = 攻撃時間記憶
; 31 = 投げ学習１
; 32 = 投げ学習２
; 33 = 中段学習１
; 34 = 中段学習２
; 35 = 下段学習１
; 36 = 下段学習２
; 37 = 空中ガード不能学習１
; 38 = 空中ガード不能学習２
; 39 = ガード不能学習
; 40 = 中段攻撃時間学習１・２
; 41 = 下段攻撃時間学習１・２
; 42 = 空中ガード不能攻撃時間学習１・２
; 43 = 立ち中段ガード判断
; 44 = 
; 45 = 
; 46 = システム有無設定
; 47 = 
; 48 = 
; 49 = 
; 50 = 
; 51 = 
; 52 = 紅蓮朱雀＆焔咆吼失敗記憶
; 53 = タッグ時相手判別
; 54 = 相手進行方向判別
; 55 = コンボルート監視
; 56 = 剣質即決定スイッチ
; 57 = 永久使用有無設定
; 58 = 弾き使用率設定
; 59 = A.I.スイッチ＆レベル設定

; f(1) = カウンター補正
; f(2) = コンボ補正
; f(3) = ダメージ値・MUGEN換算
; f(4) = 
; f(5) = 
; f(6) = 画面幅簡易測定
; f(7) = 

;---------------------------------------------------------------------------
[Data]
life = 1000
power = 3000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 20
airjuggle = 5
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 256
IntPersistIndex = 0
FloatPersistIndex = 40

[Size]
xscale = 1            ;Horizontal scaling factor.
yscale = 1            ;Vertical scaling factor.
ground.back = 15      ;Player width (back, ground)
ground.front = 15     ;Player width (front, ground)
air.back = 12         ;Player width (back, air)
air.front = 12        ;Player width (front, air)
height = 60           ;Height of player (for opponent to jump over)
attack.dist = 160     ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0      ;Set to 1 to scale projectiles too
head.pos = 5,-102     ;Approximate position of head
mid.pos = 5,-75       ;Approximate position of midsection
shadowoffset = 0      ;Number of pixels to vertically offset the shadow
draw.offset = 0,0     ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2.1       ;Walk forward
walk.back = -1.3      ;Walk backward
run.fwd  = 7.5,0      ;Run forward (x, y)
run.back = -4.5,-3.8  ;Hop backward (x, y)
jump.neu = 0,-11.0    ;Neutral jumping velocity (x, y)
jump.back = -3        ;Jump back Speed (x, y)
jump.fwd = 3          ;Jump forward Speed (x, y)
runjump.back = -5     ;Running jump speeds (opt)
runjump.fwd = 5       ;.
airjump.neu = 0,-8.1  ;.
airjump.back = -2.55  ;Air jump speeds (opt)
airjump.fwd = 2.5     ;.

[Movement]
airjump.num = 0       ;Number of air jumps allowed (opt)
airjump.height = 35   ;Minimum distance from ground before you can air jump (opt)
yaccel = .53          ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

;---------------------------------------------------------------------------
; LOSE (Time over)
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 170, 2];くっ！
type = PlaySnd
trigger1 = animelem = 3
value = 170,0

[State 170, 3]
type = ScreenBound
triggerall = enemy,stateno = [181,189]
trigger1 = enemy,name = "Genbu no Okina" && enemy,authorname = "HAL"
trigger2 = enemy,name = "Inaba Tewi" && enemy,authorname = "HAL"
trigger3 = enemy,name = "Shinnosuke Kagami" && enemy,authorname = "HAL"
trigger4 = enemy,name = "Mukuro" && enemy,authorname = "HAL"
trigger5 = enemy,name = "Moriya Minakata" && enemy,authorname = "HAL"
trigger6 = enemy,name = "Kojiroh Sanada" && enemy,authorname = "HAL"
trigger7 = enemy,name = "Juzo Kanzaki" && enemy,authorname = "HAL"
value = 0

[State 170, 4]
type = ScreenBound
trigger1 = !(enemy,name = "Genbu no Okina" && enemy,authorname = "HAL")
trigger1 = !(enemy,name = "Inaba Tewi" && enemy,authorname = "HAL")
trigger1 = !(enemy,name = "Shinnosuke Kagami" && enemy,authorname = "HAL")
trigger1 = !(enemy,name = "Mukuro" && enemy,authorname = "HAL")
trigger1 = !(enemy,name = "Moriya Minakata" && enemy,authorname = "HAL")
trigger1 = !(enemy,name = "Kojiroh Sanada" && enemy,authorname = "HAL")
trigger1 = !(enemy,name = "Juzo Kanzaki" && enemy,authorname = "HAL")
value = 0

