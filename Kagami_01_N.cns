;---------------------------------------------------------------------------
; 通常技、特殊技
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
; 5A
[Statedef 200]
type    = S
movetype= A
physics = S
juggle  = 1
velset = 0,0
ctrl = 0
anim = 200
poweradd = 0
sprpriority = 1

;---------------------[攻撃]
[State 200, 1]
type = HitDef
trigger1 = AnimElem = 6
attr = S,NA
damage = floor(ceil(ifelse(var(2)=0,13,ifelse(var(2)=1,8,9))*fvar(1)*fvar(2)-(var(4)>1))*fvar(3))*var(14),ceil(ifelse(var(2)=1,0,1)*fvar(3))
getpower = ceil(ifelse(var(2)=0,6,2)*fvar(4)),ceil(ifelse(var(2)=0,3,ifelse(var(2)=1,1,ifelse((var(46)&32),1,0)))*fvar(4))
givepower = ceil(ifelse(var(4)=1,2,0)*fvar(4)),0
animtype = Light
guardflag = M
hitflag = MAF
priority = 3,Hit
pausetime = 4,4
guard.pausetime = ifelse(var(2)=0,0,4),4
sparkno = s7000
sparkxy = -15,-36
hitsound = s202,random%6
guardsound = s120,random%2
guard.sparkno = s7020
guard.hittime = 12
guard.velocity = -3.2
ground.type = Low
ground.slidetime = 21
ground.hittime = 21
ground.velocity = -4
air.type = High
air.velocity = ifelse(var(8)=0,-2.75,2.75*(facing*enemynear,facing)),-6.75
air.hittime = 20
ground.cornerpush.veloff = -6.5
air.cornerpush.veloff = -9
guard.cornerpush.veloff = -5.75
airguard.cornerpush.veloff = -5.75
guard.kill = 0
p2facing = ifelse(var(8)=0,1,0)
yaccel = 0.43
id = ifelse(p2statetype=A,40222,200)
nochainid = ifelse(p2statetype=A,40222,-1)

;---------------------[効果音]
[State 200, 2];ボイス
type = PlaySnd
trigger1 = animelem = 3
value = 200, random%4

