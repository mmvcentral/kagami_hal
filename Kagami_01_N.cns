;---------------------------------------------------------------------------
; HIT_LIEDEAD
[Statedef 5150]
type    = L
movetype= H
physics = N
sprpriority = -3

[State 5150, 1] ;Normal anim
type = ChangeAnim
triggerall = matchover = 0
triggerall = roundstate >= 3
triggerall = anim != [5140,5149]
triggerall = selfanimexist(5140)
trigger1 = (anim != [5111,5119]) && (anim != [5171,5179])
trigger2 = !selfanimexist(5140 + (anim % 10))
value = 5140

[State 5150, 2] ;Hit up type anim
type = ChangeAnim
triggerall = matchover = 0
triggerall = roundstate >= 3
triggerall = anim != [5140,5149]
trigger1 = (anim = [5111,5119]) || (anim = [5171,5179])
trigger1 = selfanimexist(5140 + (anim % 10))
value = 5140 + (anim % 10)

[State 5150, 3] ;Match over anim
type = ChangeAnim
persistent = 0
;trigger1 = time = 0
trigger1 = matchover = 1
trigger1 = anim = [5140,5149]
trigger1 = selfanimexist(anim+10)
value = anim+10

[State 5150, 4] ;Switch to 5110 if liedead anim does not exist
type = ChangeAnim
trigger1 = time = 0
trigger1 = anim != [5140,5159]
trigger1 = anim != [5110,5119]
value = 5110

[State 5150, 5] ;Friction
type = VelMul
trigger1 = 1
x = 0.85

[State 5150, 6] ;Friction
type = VelSet
trigger1 = vel x < .05
persistent = 0
x = 0

[State 5150, 7]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 5150, 8]
type = Turn
triggerall = facing = enemy,facing
trigger1 = anim = 5140 && animelem = 13
trigger2 = anim = 5141 && animelem = 9
trigger3 = anim = 5142 && animelem = 9

[State 5150, 9]
type = PlaySnd
trigger1 = anim = 5140 && animelem = 15
trigger2 = anim = 5141 && animelem = 11
trigger3 = anim = 5142 && animelem = 11
value = 170,0
persistent = 0

[State 5150, 10]
type = ScreenBound
triggerall = enemy,stateno = [181,189]
trigger1 = enemy,name = "Genbu no Okina" && enemy,authorname = "HAL"
trigger2 = enemy,name = "Inaba Tewi" && enemy,authorname = "HAL"
trigger3 = enemy,name = "Shinnosuke Kagami" && enemy,authorname = "HAL"
trigger4 = enemy,name = "Mukuro" && enemy,authorname = "HAL"
trigger5 = enemy,name = "Moriya Minakata" && enemy,authorname = "HAL"
trigger6 = enemy,name = "Kojiroh Sanada" && enemy,authorname = "HAL"
trigger7 = enemy,name = "Juzo Kanzaki" && enemy,authorname = "HAL"
value = 0

[State 5150, 11]
type = ScreenBound
trigger1 = !(enemy,name = "Genbu no Okina" && enemy,authorname = "HAL")
trigger1 = !(enemy,name = "Inaba Tewi" && enemy,authorname = "HAL")
trigger1 = !(enemy,name = "Shinnosuke Kagami" && enemy,authorname = "HAL")
trigger1 = !(enemy,name = "Mukuro" && enemy,authorname = "HAL")
trigger1 = !(enemy,name = "Moriya Minakata" && enemy,authorname = "HAL")
trigger1 = !(enemy,name = "Kojiroh Sanada" && enemy,authorname = "HAL")
trigger1 = !(enemy,name = "Juzo Kanzaki" && enemy,authorname = "HAL")
value = 0

;---------------------------------------------------------------------------
; 勝利分岐
[Statedef 180]
type = S

[State 180, 1]
type = AssertSpecial
trigger1 = 1
flag = roundnotover

[State 180, 1]
type = ChangeState
triggerall = var(22) > 0
trigger1 = time = 20
trigger1 = matchover || teammode = turns
trigger2 = time = 70
value = 189

[State 180, 2] ;Change to stand state when done
type = Helper
triggerall = var(22) = 0
triggerall = numhelper(18001) = 0
trigger1 = time = 70 || matchover
trigger2 = (teammode = turns && time = 60)
trigger2 = matchover = 0
id = 18001
stateno = 18001
pos = 0,0

[State 180, 3]
type = ChangeState
triggerall = var(2) >= 1
trigger1 = matchover = 1 && time = 20
trigger2 = teammode = turns && time = 60
value = 185

[State 180, 4]
type = ChangeState
trigger1 = matchover = 1 && time = 20
trigger2 = teammode = turns && time = 60
value = 182

[State 180, 5]
type = ChangeState
trigger1 = time = 70
trigger1 = matchover = 0
value = 181

