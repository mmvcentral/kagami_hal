;----------------------------------------------------------------------------
; A.I.起動フラグ用ヘルパー
[Statedef 20000]
type    = A
physics = N
velset = 0,0
ctrl = 0
sprpriority = 0

[State 20000, 1]
type = Turn
trigger1 = facing != parent,facing

[State 20000, 2]
type = AssertSpecial
trigger1 = 1
flag  = invisible
flag2 = noshadow

[State 20000, 3]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 20000, 4]
type = VarSet
trigger1  = command = "a" && parent,command = "a"
trigger2  = command = "b" && parent,command = "b"
trigger3  = command = "c" && parent,command = "c"
trigger4  = command = "x" && parent,command = "x"
trigger5  = command = "y" && parent,command = "y"
trigger6  = command = "z" && parent,command = "z"
trigger7  = command = "start" && parent,command = "start"
trigger8  = command = "fwd" && parent,command = "fwd"
trigger9  = command = "back" && parent,command = "back"
trigger10 = command = "up" && parent,command = "up"
trigger11 = command = "down" && parent,command = "down"
v = 59
value = -1

[State 20000, 5]
type = DestroySelf
triggerall = ishelper
trigger1  = parent,var(59) || var(59) = -1
trigger2  = command = "a" && parent,command = "a"
trigger3  = command = "b" && parent,command = "b"
trigger4  = command = "c" && parent,command = "c"
trigger5  = command = "x" && parent,command = "x"
trigger6  = command = "y" && parent,command = "y"
trigger7  = command = "z" && parent,command = "z"
trigger8  = command = "start" && parent,command = "start"
trigger9  = command = "fwd" && parent,command = "fwd"
trigger10 = command = "back" && parent,command = "back"
trigger11 = command = "up" && parent,command = "up"
trigger12 = command = "down" && parent,command = "down"

[State 20000, 6]
type = VarSet
triggerall = var(59) != -1
triggerall = parent,ctrl
triggerall = parent,stateno != [120,159]
triggerall = parent,stateno != [5000,5099]
trigger1  = parent,command = "a"
trigger2  = parent,command = "b"
trigger3  = parent,command = "c"
trigger4  = parent,command = "x"
trigger5  = parent,command = "y"
trigger6  = parent,command = "z"
trigger7  = parent,command = "start"
trigger8  = parent,command = "fwd"
trigger9  = parent,command = "back"
trigger10 = parent,command = "up"
trigger11 = parent,command = "down"
v = 59
value = 1

