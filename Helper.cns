; 勝利ポーズ画面移動
[Statedef 18001]
type = S
ctrl = 0
anim = 7000
velset = 0,0

[State 18001, 1]
type = AssertSpecial
trigger1 = 1
flag  = noshadow
flag2 = invisible

[State 18001, 2]
type = NotHitBy
trigger1 = 1
value = SCA,AA

[State 18001, 3]
type = VelSet
trigger1 = time = 0
trigger1 = facing = 1
x = ifelse(pos x < 0, -7.0, 21.0)

[State 18001, 4]
type = VelSet
trigger1 = time = 0
trigger1 = facing = -1
x = ifelse(pos x > 0, -7.0, 21.0)

[State 18001, 5]
type = VelMul
trigger1 = root,backedgedist > 105
x = 0.845

[State 18001, 6]
type = ScreenBound
trigger1 = 1
value = 1
movecamera = 1,1

