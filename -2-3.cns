type = Helper
trigger1 = !numhelper(40222)
trigger1 = !ishelper
helpertype = normal
name = "Pre-Helper"
stateno = 40222
id = 40222
postype = p1
pos = 0,9999
keyctrl = 1
pausemovetime = 2147483647
supermovetime = 2147483647

;---------------------------------------------------------------------------
;変数確認
[State -3, DisplayToClipboard]
type = DisplayToClipboard
trigger1 = 1
text = "Var(59)=%d, Var(55)=%d, Var(58)=%d, Var(2)=%d,       Var(5)=%d"
params = Var(59), Var(55), Var(58), Var(2), Var(5);NumHelper(7030)
ignorehitpause = 1

;相手挙動確認
[State -3, AppendToClipBoard]
type = AppendToClipBoard
trigger1 = 1
text = "\nPos Y:%f Vel Y:%f Vel X:%f Dis X:%d Dis Y:%d"
params = Enemy,Pos Y, Enemy,Vel Y, Pos Y, Floor(P2BodyDist X), Floor(P2BodyDist Y)
ignorehitpause = 1

;相手挙動確認
[State -3, AppendToClipBoard]
type = null;AppendToClipBoard
trigger1 = 1
text = "\nfv1:%f fv2:%f fv3:%f v2:%d v14:%d"
params = fvar(1), fvar(2), fvar(3), var(2), var(14)
ignorehitpause = 1

;学習変数確認
[State -3, DisplayToClipboard]
type = Null;DisplayToClipboard
trigger1 = 1
text = "S1=%d, S2=%d, C1=%d, C2=%d, A1=%d"
params = Var(33), Var(34), Var(35), Var(36), Var(37)
ignorehitpause = 1

;学習変数確認
[State -3, AppendToClipBoard]
type = Null;AppendToClipBoard
trigger1 = 1
text = "\nA2=%d, No=%d, Stime=%d, Ctime=%d, ATime=%d"
params = Var(38), Var(39), Var(40), Var(41), Var(42)
ignorehitpause = 1

;その他いろいろ確認
[State -3, AppendToClipBoard]
type = AppendToClipBoard
trigger1 = 1
text = " EB=%d, F=%d"
params = Enemy,BackEdgeDist, FrontEdgeDist
ignorehitpause = 1

