;\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
; 常時管理ステート
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
[Statedef -2]
;---------------------------------------------------------------------------
[State -2, a]
type = ChangeState
trigger1 = ishelper(40222)
value = 40222
ignorehitpause = 1

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; 向き設定？
;///////////////////////////////////////////////////////////////////////////
[State -2, a];右向き設定
type = VarSet
trigger1 = var(10) = 0
trigger1 = facing = 1
v = 10
value = 1

[State -2, a];左向き設定
type = VarSet
trigger1 = var(10) = 0
trigger1 = facing = -1
v = 10
value = 2

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; 相手ステート制御
;///////////////////////////////////////////////////////////////////////////
[State -2, a]
type = TargetState
trigger1 = numtarget
trigger1 = movehit = 1 && hitpausetime <= 0
value = 238
id = 235
ignorehitpause = 1

[State -2, a]
type = TargetState
trigger1 = numtarget
trigger1 = movehit = 1 && hitpausetime <= 0
value = 268
id = 261
ignorehitpause = 1

[State -2, a]
type = TargetState
trigger1 = numtarget
trigger1 = movehit = 1 && hitpausetime <= 0
value = 265
id = 262
ignorehitpause = 1

[State -2, a]
type = TargetState
trigger1 = numtarget
trigger1 = movehit = 1 && hitpausetime <= 0
value = 435
id = 430
ignorehitpause = 1

[State -2, a]
type = TargetState
trigger1 = numtarget
trigger1 = movehit = 1 && hitpausetime <= 0
value = 435
id = 450
ignorehitpause = 1

[State -2, a]
type = TargetState
trigger1 = numtarget
trigger1 = movehit = 1 && hitpausetime <= 0
value = 238
id = 940
ignorehitpause = 1

[State -2, a]
type = TargetState
trigger1 = numtarget(630) > 0
trigger1 = target(630),statetype = A
trigger1 = movehit = 1 && hitpausetime <= 0
value = 1109
id = 630
ignorehitpause = 1

[State -2, a]
type = TargetState
trigger1 = numtarget(1050) > 0
trigger1 = target(1050),statetype = A
trigger1 = movehit = 1 && hitpausetime <= 0
value = 1109
id = 1050
ignorehitpause = 1

[State -2, a]
type = TargetState
trigger1 = numtarget
trigger1 = movehit = 1 && hitpausetime <= 0
value = 1109
id = 1100
ignorehitpause = 1

[State -2, a]
type = TargetState
trigger1 = numtarget
trigger1 = movehit = 1 && hitpausetime <= 0
value = 2950
id = 2942
ignorehitpause = 1

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; ステート奪取確認
;///////////////////////////////////////////////////////////////////////////
[State -2, a]
type = VarSet
triggerall = var(8) != 0
trigger1 = numtarget(235) = 0
trigger1 = numtarget(261) = 0
trigger1 = numtarget(262) = 0
trigger1 = numtarget(430) = 0
trigger1 = numtarget(450) = 0
trigger1 = numtarget(630) = 0
trigger1 = numtarget(940) = 0
trigger1 = numtarget(1050) = 0
trigger1 = numtarget(1100) = 0
trigger1 = numtarget(2942) = 0
trigger2 = numtarget(235) > 0
trigger2 = p2stateno != 238
trigger3 = numtarget(261) > 0
trigger3 = p2stateno != 268
trigger4 = numtarget(262) > 0
trigger4 = p2stateno != 265
trigger5 = numtarget(430) > 0
trigger5 = p2stateno != 435
trigger6 = numtarget(450) > 0
trigger6 = p2stateno != 435
trigger7 = numtarget(630) > 0
trigger7 = p2stateno != 1109
trigger8 = numtarget(940) > 0
trigger8 = p2stateno != 238
trigger9 = numtarget(1050) > 0
trigger9 = p2stateno != 1109
trigger10= numtarget(1100) > 0
trigger10= p2stateno != 1109
trigger11= numtarget(2942) > 0
trigger11= p2stateno != 2950
v = 8
value = 0
ignorehitpause = 1

[State -2, a]
type = VarSet
triggerall = var(8) = 0
trigger1 = numtarget(235) > 0
trigger1 = p2stateno = 238
trigger2 = numtarget(261) > 0
trigger2 = p2stateno = 268
trigger3 = numtarget(262) > 0
trigger3 = p2stateno = 265
trigger4 = numtarget(430) > 0
trigger4 = p2stateno = 435
trigger5 = numtarget(450) > 0
trigger5 = p2stateno = 435
trigger6 = numtarget(630) > 0
trigger6 = p2stateno = 1109
trigger7 = numtarget(940) > 0
trigger7 = p2stateno = 238
trigger8 = numtarget(1050) > 0
trigger8 = p2stateno = 1109
trigger9 = numtarget(1100) > 0
trigger9 = p2stateno = 1109
trigger10= numtarget(2942) > 0
trigger10= p2stateno = 2950
v = 8
value = 1
ignorehitpause = 1

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; 前方ジャンプ時ガード不可
;///////////////////////////////////////////////////////////////////////////
[State -2, NoAirGuard]
type = AssertSpecial
trigger1 = !(var(46) & 8)
trigger1 = vel x > 0
trigger1 = stateno = 50
flag = noairguard

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; ガード短縮リセット
;///////////////////////////////////////////////////////////////////////////
[State -2, Guard-Reset]
type = VarSet
trigger1 = var(18) != 0
trigger1 = stateno != [150,153]
v = 18
value = 0
ignorehitpause = 1

[State -2, Guard-Reset]
type = VarSet
trigger1 = var(19) != 0
trigger1 = stateno != [150,153]
v = 19
value = 0
ignorehitpause = 1

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; 叩きつけバウンドエフェクト
;///////////////////////////////////////////////////////////////////////////
[State -2, BoundEffect]
type = Explod
triggerall = numtarget
triggerall = enemy(0),movetype = H
triggerall = enemy(0),time = 1
trigger1 = enemy(0),stateno = 1066
anim = 8070
id = 8070
postype = p1
pos = floor(abs(enemy(0),pos x - pos x)),5-floor(pos y)
ownpal = 1
bindtime = 1
ignorehitpause = 1

[State -2, BoundEffect]
type = Explod
triggerall = numtarget
triggerall = numenemy >= 2
triggerall = enemy(1),movetype = H
triggerall = enemy(1),time = 1
trigger1 = enemy(1),stateno = 1066
anim = 8070
id = 8070
postype = p1
pos = floor(abs(enemy(1),pos x - pos x)),5-floor(pos y)
ownpal = 1
bindtime = 1
ignorehitpause = 1

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; 相手砂塵エフェクト
;///////////////////////////////////////////////////////////////////////////
[State -2, Explod]
type = Explod
triggerall = numtarget
triggerall = p2movetype = H
triggerall = enemynear,Time = 1
trigger1 = p2stateno = 239
trigger2 = p2stateno = 269
trigger3 = p2stateno = 436
trigger4 = p2stateno = 1066
trigger5 = p2stateno = 2021
anim = 8100
id = 8100
postype = P2
pos = 18,5
ownpal = 1
bindtime = 1
sprpriority = 2
ignorehitpause = 1

[State -2, Explod]
type = Explod
triggerall = numtarget
triggerall = p2movetype = H
triggerall = enemynear,time = 1
trigger1 = p2stateno = 239
trigger2 = p2stateno = 269
trigger3 = p2stateno = 436
trigger4 = p2stateno = 1066
trigger5 = p2stateno = 2021
anim = 8100
id = 8100
postype = P2
pos = -18,5
facing = -1
ownpal = 1
bindtime = 1
sprpriority = 2
ignorehitpause = 1

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; 連殺斬判定解除
;///////////////////////////////////////////////////////////////////////////
[State -2, a]
type = VarSet
trigger1 = movetype != A
v = 11
value = 0

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; 空中受身可能時間算出
;///////////////////////////////////////////////////////////////////////////
[State -2, a]
type = VarSet
trigger1 = 1
v = 7
value = (gethitvar(fall.recovertime) - gethitvar(fall.time))

[State -2, a]
type = VarSet
trigger1 = var(7) <= 0
v = 7
value = 0

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; ダメージ時のエフェクト、サウンドの消去
;///////////////////////////////////////////////////////////////////////////
;ダメージ時のエフェクトの消去
[State -2, a]
type = RemoveExplod
trigger1 = movetype = H
ID = 4000

;ダメージ時のサウンドの消去
[State -2, a]
type = StopSnd
trigger1 = movetype = H
channel = 1

;ダメージ時のサウンドの消去
[State -2, a]
type = StopSnd
trigger1 = movetype = H
channel = 3

;ダメージ時のサウンドの消去
[State -2, a]
type = StopSnd
trigger1 = movetype = H
channel = 4

;ダメージ時の残像の消去
[State -2, a]
type = AfterImageTime
trigger1 = movetype = H && stateno != 2950
trigger2 = prevstateno = 100 && stateno != 101
trigger3 = prevstateno = 101
trigger4 = prevstateno = 105
trigger5 = prevstateno = 1400
trigger6 = prevstateno = 1450
trigger7 = stateno = 0
trigger8 = stateno = 10
trigger9 = stateno = 20
trigger10= stateno = 40
time = 0

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; ゲージ増加抑制
;///////////////////////////////////////////////////////////////////////////
[State -2, a]
type = PowerSet
triggerall = power >= 1000
trigger1 = teammode = single
trigger2 = teammode = turns
value = 1000
ignorehitpause = 1

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; 永久防止
;///////////////////////////////////////////////////////////////////////////
[State -2, Limit1]
type = VarSet
triggerall = teammode = single || teammode = turns
trigger1 = p2movetype != H
trigger2 = p2stateno = [120,159]
trigger3 = p2movetype = I && p2stateno = [5200,5201]
v = 13
value = enemynear,life
ignorehitpause = 1

[State -2, Limit2]
type = TargetLifeAdd
triggerall = (var(46) & 1)
triggerall = teammode = single || teammode = turns
triggerall = enemy,alive
trigger1 = (var(13) - enemynear,life) > (enemynear,lifemax * 0.703)
value = floor(var(13) - (enemynear,lifemax * 0.704)) - (enemynear,life)
ignorehitpause = 1

[State -2, Limit3]
type = VarSet
trigger1 = 1
v = 14
value = 1
ignorehitpause = 1

[State -2, Limit4]
type = VarSet
triggerall = (var(46) & 1)
triggerall = teammode = single || teammode = turns
triggerall = p2movetype = H
trigger1 = (var(13) - enemynear,life) > (enemynear,lifemax * 0.703)
v = 14
value = 0
ignorehitpause = 1

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; 根性値補正
;///////////////////////////////////////////////////////////////////////////
[State -2, a]
type = LifeAdd
triggerall = alive
triggerall = stateno != [120,159]
triggerall = var(23) - life > 1
trigger1 = var(24) = 0
trigger1 = ((life*1000)/lifemax) > 440
value = floor((var(23) - life) - ((var(23) - life) * (ifelse(var(2) = 2 && !(Var(46) & 16), 1.250, 1.000) * 1.000)))
absolute = 1
ignorehitpause = 1

[State -2, a]
type = LifeAdd
triggerall = alive
triggerall = stateno != [120,159]
triggerall = var(23) - life > 1
trigger1 = var(24) = 0
trigger1 = ((life*1000)/lifemax) = [254,440]
value = floor((var(23) - life) - ((var(23) - life) * (ifelse(var(2) = 2 && !(Var(46) & 16), 1.250, 1.000) * 0.850)))
absolute = 1
ignorehitpause = 1

[State -2, a]
type = LifeAdd
triggerall = alive
triggerall = stateno != [120,159]
triggerall = var(23) - life > 1
trigger1 = var(24) = 0
trigger1 = ((life*1000)/lifemax) = [129,253]
value = floor((var(23) - life) - ((var(23) - life) * (ifelse(var(2) = 2 && !(Var(46) & 16), 1.250, 1.000) * 0.800)))
absolute = 1
ignorehitpause = 1

[State -2, a]
type = LifeAdd
triggerall = alive
triggerall = stateno != [120,159]
triggerall = var(23) - life > 1
trigger1 = var(24) = 0
trigger1 = ((life*1000)/lifemax) < 129
value = floor((var(23) - life) - ((var(23) - life) * (ifelse(var(2) = 2 && !(Var(46) & 16), 1.250, 1.000) * 0.750)))
absolute = 1
ignorehitpause = 1

[State -2, a]
type = DefenceMulSet
trigger1 = var(24) = 1
trigger1 = ((life*1000)/lifemax) > 440
value = ifelse(var(2) = 2 && !(var(46) & 16), 1.250, 1.000) * 1.000
ignorehitpause = 1

[State -2, a]
type = DefenceMulSet
trigger1 = var(24) = 1
trigger1 = ((life*1000)/lifemax) = [254,440]
value = ifelse(var(2) = 2 && !(var(46) & 16), 1.250, 1.000) * 0.850
ignorehitpause = 1

[State -2, a]
type = DefenceMulSet
trigger1 = var(24) = 1
trigger1 = ((life*1000)/lifemax) = [129,253]
value = ifelse(var(2) = 2 && !(var(46) & 16), 1.250, 1.000) * 0.800
ignorehitpause = 1

[State -2, a]
type = DefenceMulSet
trigger1 = var(24) = 1
trigger1 = ((life*1000)/lifemax) < 129
value = ifelse(var(2) = 2 && !(var(46) & 16), 1.250, 1.000) * 0.750
ignorehitpause = 1

[State -2, a]
type = VarSet
trigger1 = movetype != H
var(24) = -1
ignorehitpause = 1

[State -2, a]
type = VarSet
trigger1 = var(24) = -1
trigger1 = stateno = [5000,5120]
var(24) = 0
ignorehitpause = 1

[State -2, a]
type = VarSet
triggerall = movetype = H
trigger1 = var(23) - life != 0
trigger2 = hitshakeover
trigger3 = stateno != [5000,5120]
var(24) = 1
ignorehitpause = 1

[State -2, a]
type = VarSet
trigger1 = var(23) - life != 0
var(23) = life
ignorehitpause = 1

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; 相手弾かれ状態判定
;///////////////////////////////////////////////////////////////////////////
[State -2, a]
type = VarSet
trigger1 = var(17) = 1
trigger1 = !(p2movetype = H && p2stateno = [930,931])
v = 17
value = 0
ignorehitpause = 1

[State -2, a]
type = VarSet
trigger1 = var(17) = 0
trigger1 = p2movetype = H && p2stateno = [930,931]
v = 17
value = 1
ignorehitpause = 1

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; 弾き成立カウンター判定
;///////////////////////////////////////////////////////////////////////////
[State -2, a]
type = VarSet
trigger1 = numtarget
trigger1 = p2movetype = H
trigger1 = p2stateno = 931
trigger1 = enemy,time = 3
v = 21
value = 21
ignorehitpause = 1

[State -2, a]
type = VarAdd
trigger1 = var(21) > 0
v = 21
value = -1
ignorehitpause = 1

[State -2, a]
type = VarSet
trigger1 = var(21) <= 0
v = 21
value = 0
ignorehitpause = 1

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; カウンターヒット補正
;///////////////////////////////////////////////////////////////////////////
[State -2, a]
type = VarSet
trigger1 = p2movetype != A
fv = 1
value = 1.0

[State -2, a]
type = VarSet
trigger1 = p2movetype = A
trigger2 = var(21) > 0
trigger3 = numtarget
trigger3 = p2statetype = A
trigger3 = p2stateno = 931
fv = 1
value = 1.3

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; コンボによるダメージ補正
;///////////////////////////////////////////////////////////////////////////
[State -2, a];ヒット数初期化
type = VarSet
trigger1 = p2movetype != H
v = 4
value = 1
ignorehitpause = 1

;---------------------[連続技補正（力）]
[State -2, a]
type = VarSet
triggerall = var(2) = 0
trigger1 = var(4) = [0,1]
fvar(2) = 1.0
ignorehitpause = 1

[State -2, a]
type = VarSet
triggerall = var(2) = 0
trigger1 = var(4) = 2
fvar(2) = 0.9
ignorehitpause = 1

[State -2, a]
type = VarSet
triggerall = var(2) = 0
trigger1 = var(4) = [3,4]
fvar(2) = 0.8
ignorehitpause = 1

[State -2, a]
type = VarSet
triggerall = var(2) = 0
trigger1 = var(4) >= 5
fvar(2) = 0.7
ignorehitpause = 1

;---------------------[連続技補正（技）]
[State -2, a]
type = VarSet
triggerall = var(2) = 1
trigger1 = var(4) = [0,1]
fvar(2) = 1.0
ignorehitpause = 1

[State -2, a]
type = VarSet
triggerall = var(2) = 1
trigger1 = var(4) = [2,4]
fvar(2) = 0.9
ignorehitpause = 1

[State -2, a]
type = VarSet
triggerall = var(2) = 1
trigger1 = var(4) = [5,7]
fvar(2) = 0.8
ignorehitpause = 1

[State -2, a]
type = VarSet
triggerall = var(2) = 1
trigger1 = var(4) = [8,10]
fvar(2) = 0.7
ignorehitpause = 1

[State -2, a]
type = VarSet
triggerall = var(2) = 1
trigger1 = var(4) >= 11
fvar(2) = 0.6
ignorehitpause = 1

;---------------------[連続技補正（極）]
[State -2, a]
type = VarSet
triggerall = var(2) = 2
trigger1 = var(4) = [0,1]
fvar(2) = 1.0
ignorehitpause = 1

[State -2, a]
type = VarSet
triggerall = var(2) = 2
trigger1 = var(4) = 2
fvar(2) = 0.9
ignorehitpause = 1

[State -2, a]
type = VarSet
triggerall = var(2) = 2
trigger1 = var(4) = 3
fvar(2) = 0.8
ignorehitpause = 1

[State -2, a]
type = VarSet
triggerall = var(2) = 2
trigger1 = var(4) = [4,7]
fvar(2) = 0.7
ignorehitpause = 1

[State -2, a]
type = VarSet
triggerall = var(2) = 2
trigger1 = var(4) = [8,14]
fvar(2) = 0.6
ignorehitpause = 1

[State -2, a]
type = VarSet
triggerall = var(2) = 2
trigger1 = var(4) >= 15
fvar(2) = 0.5
ignorehitpause = 1

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; ダメージ値・MUGEN換算
;///////////////////////////////////////////////////////////////////////////
[State -2, a]
type = VarSet
trigger1 = 1
fvar(3) = 3.90625
ignorehitpause = 1

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; パワーゲージ値・MUGEN換算
;///////////////////////////////////////////////////////////////////////////
[State -2, a]
type = VarSet
trigger1 = 1
fvar(4) = 15.625
ignorehitpause = 1

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; 後の先表示
;///////////////////////////////////////////////////////////////////////////
[State -2, a]
type = Explod
triggerall = numexplod(9900) = 0
triggerall = teamside = 1
triggerall = fvar(1) = 1.3
triggerall = p2movetype = H
triggerall = p2stateno != [120,199]
trigger1 = movehit = 1
trigger1 = stateno != [800,939]
trigger2 = numhelper(1000) > 0
trigger2 = helper(1000),movehit = 1
trigger3 = numhelper(2100) > 0
trigger3 = helper(2100),movehit = 1
anim = 9900
id = 9900
postype = left
pos = 60,100
ontop = 1
ownpal = 1
bindtime = -1
ignorehitpause = 1
pausemovetime = 999999999
supermovetime = 999999999

[State -2, a]
type = Explod
triggerall = numexplod(9900) = 0
triggerall = teamside = 2
triggerall = fvar(1) = 1.3
triggerall = p2movetype = H
triggerall = p2stateno != [120,199]
trigger1 = movehit = 1
trigger1 = stateno != [800,939]
trigger2 = numhelper(1000) > 0
trigger2 = helper(1000),movehit = 1
trigger3 = numhelper(2100) > 0
trigger3 = helper(2100),movehit = 1
anim = 9901
id = 9900
postype = right
pos = -60,100
ontop = 1
ownpal = 1
bindtime = -1
ignorehitpause = 1
pausemovetime = 999999999
supermovetime = 999999999

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; 完全勝利判定
;///////////////////////////////////////////////////////////////////////////
[State -2, a]
type = VarSet
trigger1 = roundstate = [0,1]
v = 22
value = life

[State -2, a]
type = VarSet
trigger1 = roundstate = 2
trigger1 = var(22) != life
v = 22
value = 0

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; フィニッシュタイム停止
;///////////////////////////////////////////////////////////////////////////
[State -2, a]
type = AssertSpecial
triggerall = enemynear,life < 4
triggerall = p2movetype = H && p2stateno != [120,159]
triggerall = stateno = 2010 || stateno = 2510 || stateno = [2900,2949]
trigger1 = enemy,teammode = single
trigger2 = enemy,teammode = turns
trigger3 = enemy,teammode = simul && numenemy = 2
trigger3 = enemy(0),alive && !(enemy(1),alive) || (enemy(1),alive && !(enemy(0),alive))
flag = TimerFreeze
ignorehitpause = 1

[State -2, a]
type = AssertSpecial
triggerall = enemynear,life < 4
triggerall = p2movetype = H && p2stateno != [120,159]
triggerall = movehit && (stateno = 2000 || stateno = 2500)
trigger1 = enemy,teammode = single
trigger2 = enemy,teammode = turns
trigger3 = enemy,teammode = simul && numenemy = 2
trigger3 = enemy(0),alive && !(enemy(1),alive) || (enemy(1),alive && !(enemy(0),alive))
flag = TimerFreeze
ignorehitpause = 1

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; 画面幅簡易測定
;///////////////////////////////////////////////////////////////////////////
[State -2, a]
type = VarSet
trigger1 = 1
fv = 6
value = ifelse((screenpos x - pos x) - 160 <= 0, 1.0, (screenpos x - pos x) / 160)
ignorehitpause = 1

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; ダメージボイス
;///////////////////////////////////////////////////////////////////////////
[State -2, a]
type = PlaySnd
triggerall = stateno = 5000 ||  stateno = 5010 || stateno = 5020
triggerall = time = 0
triggerall = alive = 1
trigger1 = gethitvar(animtype) = 0
value = 5000,0+(random%4)
persistent = 0

[State -2, a]
type = PlaySnd
triggerall = stateno = 5000 ||  stateno = 5010 || stateno = 5020
triggerall = time = 0
triggerall = alive = 1
trigger1 = gethitvar(animtype) = 1
value = 5001,0+(random%4)
persistent = 0

[State -2, a]
type = PlaySnd
triggerall = stateno = 5000 ||  stateno = 5010 || stateno = 5020
triggerall = time = 0
triggerall = alive = 1
trigger1 = gethitvar(animtype) = 2
trigger2 = gethitvar(animtype) = 3
trigger3 = gethitvar(animtype) = 4
value = 5002,0+(random%4)
persistent = 0

[State -2, a];KO
type = PlaySnd
triggerall = var(12) = 0
triggerall = stateno != 5150
trigger1 = matchover
trigger1 = life = 0
value = 12,0+random%3
channel = 2
persistent = 0
ignorehitpause = 1

[State -2, a];Bound
type = PlaySnd
triggerall = numtarget
triggerall = target,movetype = H
triggerall = target,time = 1
trigger1 = target,stateno = 239
trigger2 = target,stateno = 269
trigger3 = target,stateno = 436
trigger4 = target,stateno = 1066
trigger5 = target,stateno = 1067
trigger6 = target,stateno = 2021
trigger7 = target,stateno = 2523
value = S5100,0

[State -2, a]
type =  VarSet
trigger1 = matchover
trigger1 = life = 0
