;起き上がり行動制限

[State 25000, 起き上がり行動制限1]
type = VarSet
triggerall = var(48) <= 0
triggerall = root,pos y >= 0
trigger1 = root,stateno = 710 && root,animtime >= -1
trigger2 = root,stateno = 5120 && root,animtime >= -1
