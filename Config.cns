;---------------------------------------------------------------------------
; 各種項目設定
;---------------------------------------------------------------------------
; Initialize (at the start of the round)
[Statedef 5900]
type = S

[State 5900, 1] ;Clear all int variables
type = VarRangeSet
trigger1 = roundsexisted = 0
value = 0

[State 5900, 2] ;Clear all float variables
type = VarRangeSet
trigger1 = roundsexisted = 0
fvalue = 0

;===========================================================================
; 本体関連設定 ここから
;===========================================================================
;※設定方法の説明
;value = ○ * (★)　← この記述がある場所の【★】を任意の数字に変更してください。


;限界ダメージ有無設定
[State -3, Config_1]
type = VarAdd
trigger1 = !(var(46) & 1)
v = 46
value = 1 * (1)		;← 限界ダメージの有無を設定できます。（ただし、ダッグ戦は機能しません。）
ignorehitpause = 1	;「コンボの合計ダメージが約7割を超えるとそれ以降はダメージが入らなくなる」
			;という原作の仕様で、これのおかげで即死が出来ないようになっています。
			;嘉神は永久コンボがあるから、ここの設定は結構大事だったりするかなー･･･？
			;０ ･･･ 限界ダメージなし
			;１ ･･･ 限界ダメージあり（原作通り）		※デフォルト


;自動復帰ステート中の無敵設定
[State -3, Config_2]
type = VarAdd
trigger1 = !(var(46) & 2)
trigger1 = !(var(46) & 4)
v = 46
value = 2 * (1)		;← 自動復帰ステート(State 5040)中を無敵にするかどうかを設定できます。
ignorehitpause = 1	;原作の「デフォルトで追撃不可、追撃可能技が当たった場合は専用判定が出現し追撃可能」
			;の仕様をMUGENで再現するための設定です。
			;設定を出したり消したりは出来ないので、無敵で再現してあります。
			;０ ･･･ 無敵なし
			;１ ･･･ HitOver後に無敵あり			※デフォルト
			;２ ･･･ ステート中は完全無敵


;前方ジャンプガード設定
[State -3, Config_3]
type = VarAdd
trigger1 = !(var(46) & 8)
v = 46
value = 8 * (1)		;← 前方ジャンプ時にガードが出来るかどうかを設定できます。
ignorehitpause = 1	;文字通りですが、原作では前方ジャンプ時ではガードが出来ない仕様になっています。
			;MUGENではデメリットになるだけなので、可能・不可能を設定できるようにー。
			;０ ･･･ 前方ジャンプ時ガード不可（原作通り）
			;１ ･･･ 前方ジャンプ時ガード可能		※デフォルト


;極剣質防御力設定
[State -3, Config_4]
type = VarAdd
trigger1 = !(var(46) & 16)
v = 46
value = 16 * (1)	;← 「極」剣質時での防御力を設定できます。
ignorehitpause = 1	;原作では「極」剣質になると防御力が低下します。
			;･････が、あまりにも脆くなりすぎなので緩和できる設定を設けてみました。
			;０ ･･･ 防御力低下あり（原作通り）
			;１ ･･･ 防御力低下なし				※デフォルト


;極剣質ゲージ回収率設定
[State -3, Config_5]
type = VarAdd
trigger1 = !(var(46) & 32)
v = 46
value = 32 * (1)	;← 「極」剣質時でのゲージ回収率を設定できます。
ignorehitpause = 1	;こちらも原作の「極」剣質だと、極端にゲージが回収できなくなるので･･･。
			;設定をＯＮにすると、攻撃をガードされた時の回収率が少しだけ緩和されます。
			;０ ･･･ ゲージ回収率増加なし（原作通り）
			;１ ･･･ ゲージ回収率増加あり			※デフォルト


;ガード硬直短縮設定
[State -3, Config_6]
type = VarAdd
trigger1 = !(Var(46) & 64)
v = 46
value = 64 * (0)	;← 原作での最重要テクニック、ガード硬直短縮が出来るかどうかを設定できます。
ignorehitpause = 1	;ガードの硬直中に「しゃがみガード → 立ちガード」または「立ちガード → しゃがみガード」
			;と切り替えると、ガード時の硬直時間が短縮されます。
			;０ ･･･ ガード硬直短縮不可			※デフォルト
			;１ ･･･ ガード硬直短縮可能（原作通り）


;===========================================================================
; 本体関連設定 ここまで
;===========================================================================

[State 5900, 3]
type = Helper
trigger1 = time = 0
helpertype = normal
name = "wipe_effect"
stateno = 12000
id = 12000
pos = 0,0
postype = left
keyctrl = 0
persistent = 0
ignorehitpause = 1
pausemovetime = 999999999
supermovetime = 999999999

[State 5900, 4] ;Intro for round 1
type = ChangeState
trigger1 = roundsexisted = 0
value = 190

;---------------------------------------------------------------------------
[Statedef 25000]
ctrl = 0
anim = 25000

[State 25000]
type = SelfState
trigger1 = !ishelper
value = 0

[State 25000]
type = AssertSpecial
trigger1 = ishelper
flag = invisible

[State 25000]
type = AssertSpecial
trigger1 = root,numexplod(8000) > 0
flag = nofg

[State 25000]
type = NotHitBy
trigger1 = 1
value = SCA
ignorehitpause = 1

;===========================================================================
; A.I.関連設定 ここから
;===========================================================================
;※設定方法の説明
;value = ★　← この記述がある場所の【★】を任意の数字に変更してください。


;A.I.常時起動設定
[State -3, AI]
type = VarSet
trigger1 = var(59) = 0
v = 59
value = 0		;← 常時A.I.を起動するかどうかの設定ができます。
ignorehitpause = 1	;０がＯＦＦ、１がＯＮになります。
			;※ＯＮにするとA.I.の起動が早くなりますが、プレイヤー操作は出来なくなります。


;A.I.レベル設定
[State -3, AI]
type = VarSet
trigger1 = var(59) > 0
trigger2 = root,var(59) > 0
v = 59
value = 10		;← A.I.の強さを変更することが出来ます。０～１０の間で設定してください。
ignorehitpause = 1


;A.I.弾き使用率設定
[State -3, AI]
type = VarSet
trigger1 = var(58) = 0
v = 58
value = 25		;← 相手の攻撃に対して、弾きを使用するかどうかの確立を設定できます。
ignorehitpause = 1	;０～１００の間で設定してください。
			;※使用率を｢100｣に設定しても、全て弾いてくれるというわけではないです。
			;攻撃の種類や相手との距離によっては、弾きを使用しません。


;剣質設定
[State -1, AI]
type = VarSet
triggerall = var(56) = 0
trigger1 = roundstate = 1
trigger2 = teammode = turns
trigger2 = roundsexisted = 0
trigger2 = roundno >= 2
v = 56
value = 0		;← １～３の数字を選択すると、剣質が即座に決定できます。A.I.じゃなくても有効になってます。
ignorehitpause = 1	;０ ･･･ 即決定を使用しません。あらかじめカラーごとに決められている剣質になります。
			;１ ･･･ 剣質「力」で固定になります。
			;２ ･･･ 剣質「技」で固定になります。
			;３ ･･･ 剣質「極」で固定になります。


;永久コンボ使用有無設定
[State -1, AI]
type = VarSet
trigger1 = var(57) = 0
v = 57
value = 0		;← 技・極剣質限定での、永久コンボを使用するかどうかを決定できます。
ignorehitpause = 1	;０～４の数字を設定してください。
			;嘉神は小足からの始動が可能なので狙う機会が多いですが、月華の中では最大級の難易度を誇ります。
			;･････が、A.I.の前では無に等しかったですねー。これは酷い。
			;また、A.I.レベル等の設定によっては失敗するようになってるのでご安心(？)をー。
			;０ ･･･ 永久コンボを使用しません。
			;１ ･･･ 低確率で永久コンボを使用します。
			;２ ･･･ 高確率で永久コンボを使用します。
			;３ ･･･ 始動技が当たれば必ず永久コンボを使用します。
			;４ ･･･ オマケ。理論上は可能な永久コンボです。【ニコニコ動画 → sm2550548】


;===========================================================================
; A.I.関連設定 ここまで
;===========================================================================


;ここから先、弄っちゃダメ！


;----------------------------------------------------------------------------
;----------------------------------------------------------------------------
;============================================================================
;============================================================================
;──────────────────────────────────────
;──────────────────────────────────────
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

;嘉神慎之介 学習ヘルパー

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;──────────────────────────────────────
;──────────────────────────────────────
;============================================================================
;============================================================================
;----------------------------------------------------------------------------
;----------------------------------------------------------------------------

;---------------------------------------------------------------------------
;使用変数一覧
;---------------------------------------------------------------------------
;var(0)		：ガードヘルパー用
;var(1)-(5)	：飛び道具への対策
;var(6)-(9)	：対人用対空ガード再現
;var(10)	：相手StateNo記憶(常時記憶)
;var(11)	：相手StateType反応
;var(12)	：攻撃間合い簡易判定
;var(13)	：MoveType=Aの時間記憶
;var(14)	：自分のStateNo監視
;var(15)	：空対地攻撃範囲学習Ｘ
;var(16)	：空対地攻撃範囲学習Ｙ
;var(17)-(18)	：弾き使用状況判断
;var(21)	：起き上がり投げ無敵判別
;var(29)	：やられ状態判別補助
;var(30)	：ガード方向
;var(31)-(32)	：投げ技学習
;var(33)-(34)	：中段攻撃学習
;var(35)-(36)	：下段攻撃学習
;var(37)-(38)	：空中ガード不可攻撃・空対空攻撃学習
;var(39)	：地上ガード不可攻撃学習
;var(40)	：中段攻撃時間学習
;var(41)	：下段攻撃時間学習
;var(42)	：空中ガード不可攻撃・空対空攻撃時間学習
;var(43)-(47)	：起き攻め学習
;var(48)	：起き上がり行動制限
;var(49)	：
;var(50)	：
;var(51)	：
;var(52)	：
;var(53)	：
;var(54)	：
;var(55)	：
;var(56)	：剣質即決定スイッチ
;var(57)	：永久使用有無設定
;var(58)	：弾き使用率設定
;var(59)	：A.I.スイッチ＆レベル設定

;---------------------------------------------------------------------------
;念のため再反映

[State 25000, 学習再反映]
type = Null
trigger1  = root,var(31) != 0
trigger1  = var(31) = 0
trigger1  = var(31) := root,var(31)
trigger2  = root,var(32) != 0
trigger2  = var(32) = 0
trigger2  = var(32) := root,var(32)
trigger3  = root,var(33) != 0
trigger3  = var(33) = 0
trigger3  = var(33) := root,var(33)
trigger4  = root,var(34) != 0
trigger4  = var(34) = 0
trigger4  = var(34) := root,var(34)
trigger5  = root,var(35) != 0
trigger5  = var(35) = 0
trigger5  = var(35) := root,var(35)
trigger6  = root,var(36) != 0
trigger6  = var(36) = 0
trigger6  = var(36) := root,var(36)
trigger7  = root,var(37) != 0
trigger7  = var(37) = 0
trigger7  = var(37) := root,var(37)
trigger8  = root,var(38) != 0
trigger8  = var(38) = 0
trigger8  = var(38) := root,var(38)
trigger9  = root,var(39) != 0
trigger9  = var(39) = 0
trigger9  = var(39) := root,var(39)
trigger10 = root,var(40) != 0
trigger10 = var(40) = 0
trigger10 = var(40) := root,var(40)
trigger11 = root,var(41) != 0
trigger11 = var(41) = 0
trigger11 = var(41) := root,var(41)
trigger12 = root,var(42) != 0
trigger12 = var(42) = 0
trigger12 = var(42) := root,var(42)

;---------------------------------------------------------------------------
;ガードめくり対策

[State 25000, InGuardDist]
type = Turn
trigger1 = facing * ifelse((enemy(root,var(53)),pos x - pos x) >= 0, 1,-1) < 0
ignorehitpause = 1

[State 25000, InGuardDist]
type = VarSet
trigger1 = enemy(root,var(53)),facing * ifelse((enemy(root,var(53)),pos x - root,pos x) >= 0, 1,-1) <= 0
trigger2 = !enemy(root,var(53)),hitdefattr = A, NA, SA, HA
var(0) = 0
ignorehitpause = 1

[State 25000, InGuardDist]
type = VarSet
trigger1 = enemy(root,var(53)),facing * ifelse((enemy(root,var(53)),pos x - root,pos x) >= 0, 1,-1) > 0
trigger1 = enemy(root,var(53)),hitdefattr = A, NA, SA, HA
var(0) = 1
ignorehitpause = 1

[State 25000, InGuardDist]
type = PosSet
trigger1 = ishelper
x = root,pos x + ifelse((enemy(root,var(53)),pos y < 0 && var(0) = 1),(enemy(root,var(53)),const(size.attack.dist)),(enemy(root,var(53)),const(size.proj.attack.dist))) * (enemy(root,var(53)),facing)
y = root,pos y
ignorehitpause = 1

[State 25000, InGuardDist]
type = PosSet
trigger1 = ishelper
trigger1 = backedgebodydist <= 0
x = ifelse(facing = 1, -160, 160)
y = root,pos y
ignorehitpause = 1

;---------------------------------------------------------------------------
;飛び道具への対策

;飛び道具判定
[State 25000, Helper_1]
type = VarSet
triggerall = var(1) = 0
triggerall = enemynear,numhelper > 0
triggerall = roundstate = 2 && root,ctrl = 1
trigger1 = enemy,teammode = single
trigger2 = enemy,teammode = turns
v = 1
value = enemynear,numhelper

[State 25000, Helper_2]
type = VarSet
triggerall = var(1) = 0
trigger1 = enemy,teammode = simul
trigger1 = enemy,numhelper > 0
trigger1 = roundstate = 2 && root,ctrl = 1
v = 1
value = enemy,numhelper

[State 25000, Proj_1]
type = VarSet
triggerall = var(2) = 0
triggerall = enemynear,numproj > 0
triggerall = enemynear,prevstateno = [190,199]
trigger1 = enemy,teammode = single
trigger2 = enemy,teammode = turns
v = 2
value = enemynear,numproj

[State 25000, Proj_2]
type = VarSet
triggerall = var(2) = 0
trigger1 = enemy,teammode = simul
trigger1 = enemy,numproj > 0
trigger1 = enemynear,prevstateno = [190,199]
v = 2
value = enemy,numproj

[State 25000, 誤検出対策_Helper]
type = Null
trigger1 = enemy,numhelper = var(1)
trigger1 = var(4) := 0 || 1
trigger2 = var(4) >= 180
trigger2 = var(1) := var(1) - 1
trigger3 = enemy,numhelper < var(1)
trigger3 = var(4) := var(4) + 1

[State 25000, 誤検出対策_Proj]
type = Null
trigger1 = enemy,numproj = var(2)
trigger1 = var(5) := 0 || 1
trigger2 = var(5) >= 120
trigger2 = var(2) := var(2) - 1
trigger3 = enemy,numproj < var(2)
trigger3 = var(5) := var(5) + 1

[State 25000, 測定以降出現対策]
type = Null
trigger1 = enemy,numhelper > var(1)
trigger1 = !root,inguarddist && inguarddist
trigger1 = var(3) := 3
trigger2 = enemy,numproj > var(2)
trigger2 = !root,inguarddist && inguarddist
trigger2 = var(3) := 3
trigger3 = enemy,numhelper > var(1)
trigger3 = root,inguarddist
trigger3 = var(3) := 2
trigger4 = enemy,numproj > var(2)
trigger4 = root,inguarddist
trigger4 = var(3) := 2
trigger5 = enemy,numhelper > var(1)
trigger5 = !root,inguarddist
trigger5 = var(3) := 1
trigger6 = enemy,numproj > var(2)
trigger6 = !root,inguarddist
trigger6 = var(3) := 1
trigger7 = enemy,numhelper = var(1)
trigger7 = root,ctrl || (root,stateno != [120,155])
trigger7 = var(3) := 0 || 1
trigger8 = enemy,numproj = var(2)
trigger8 = root,ctrl || (root,stateno != [120,155])
trigger8 = var(3) := 0 || 1

;---------------------------------------------------------------------------
;対人用対空ガード再現

[State 25000, Guard_1]
type = VarSet
triggerall = var(6) != 0
trigger1 = enemynear(root,var(53)),statetype != A || enemynear(root,var(53)),movetype != A
trigger2 = root,movetype = H
trigger2 = root,stateno != [120,159]
var(6) = 0
ignorehitpause = 1

[State 25000, Guard_2]
type = Null
trigger1 = enemynear(root,var(53)),statetype = A
trigger1 = var(7) := var(7) + 1
trigger2 = enemynear(root,var(53)),statetype != A
trigger2 = var(7) := 0 || 1

[State 25000, Guard_3]
type = VarSet
trigger1 = var(6) = 0
trigger1 = enemynear(root,var(53)),statetype = A
trigger1 = enemynear(root,var(53)),movetype = A
trigger1 = random < 1000 - floor(1000 - abs(enemynear(root,var(53)),pos y * 6))
trigger2 = var(6) != 1
trigger2 = enemynear(root,var(53)),vel y * (enemynear(root,var(53)),statetime * 0.1) > 3.0
trigger3 = var(7) != 0
trigger3 = var(7) >= 12 + floor(var(8)) || var(7) >= 35 || (enemynear(root,var(53)),statetype = A && var(8) <= 1)
trigger4 = var(7) != 0
trigger4 = var(11) = 11
trigger4 = var(13) >= 8 + floor(var(8)) || var(13) >= 30 || (enemynear(root,var(53)),statetype = A && var(8) <= 3)
var(6) = 1
ignorehitpause = 1

[State 25000, Guard_4]
type = VarSet
triggerall = var(6) = 0
trigger1 = enemynear(root,var(53)),statetype = A
trigger1 = enemynear(root,var(53)),movetype = A
trigger1 = random < floor(1000 - abs(enemynear(root,var(53)),pos y * 6))
var(6) = -1
ignorehitpause = 1

[State 25000, Guard_5]
type = VarSet
trigger1 = gametime%60 = 0
var(8) = 1 * (random%(21 - root,var(59)))

[State 25000, Guard_6]
type = VarSet
triggerall = var(9) > 1
trigger1 = var(6) = 1
trigger2 = var(9) > 59
trigger3 = root,statetype = C
trigger3 = root,stateno = [120,159]
trigger4 = root,statetype = S
trigger4 = root,stateno = [5000,5099]
var(9) = 0
ignorehitpause = 1

[State 25000, Guard_7]
type = VarSet
trigger1 = enemynear(root,var(53)),statetype = A
var(9) = 1
ignorehitpause = 1

[State 25000, Guard_8]
type = VarAdd
trigger1 = var(9) > 0
trigger1 = enemynear(root,var(53)),statetype != A
var(9) = 1
ignorehitpause = 1

;---------------------------------------------------------------------------
;相手StateType反応

[State 25000, stateno]
type = VarSet
trigger1 = 1
v = 10
value = enemynear(root,var(53)),stateno

[State 25000, stateno]
type = VarSet
trigger1 = var(11) != 0
trigger1 = enemynear(root,var(53)),movetype != A
v = 11
value = 0
ignorehitpause = 1

[State 25000, stateno]
type = VarSet
trigger1 = var(11) = 0
trigger1 = enemynear(root,var(53)),stateno = var(10)
trigger1 = enemynear(root,var(53)),statetime = 1
trigger1 = enemynear(root,var(53)),movetype = A
trigger1 = enemynear(root,var(53)),statetype != A
v = 11
value = 1
ignorehitpause = 1

[State 25000, stateno]
type = VarSet
trigger1 = var(11) = 0
trigger1 = enemynear(root,var(53)),stateno = var(10)
trigger1 = enemynear(root,var(53)),statetime = 1
trigger1 = enemynear(root,var(53)),movetype = A
trigger1 = enemynear(root,var(53)),statetype = A
v = 11
value = 2
ignorehitpause = 1

[State 25000, stateno]
type = VarSet
trigger1 = var(11) = 1
trigger1 = enemynear(root,var(53)),stateno = var(10)
trigger1 = enemynear(root,var(53)),movetype = A
trigger1 = enemynear(root,var(53)),statetype = A
v = 11
value = var(11) + 10
ignorehitpause = 1

[State 25000, stateno]
type = VarSet
trigger1 = var(11) = 2
trigger1 = enemynear(root,var(53)),stateno = var(10)
trigger1 = enemynear(root,var(53)),movetype = A
trigger1 = enemynear(root,var(53)),statetype != A
v = 11
value = var(11) + 10
ignorehitpause = 1

;--------------------------------------------------------------------------
;攻撃間合い簡易判定

[State 25000, P2BodyDist X]
type = VarSet
triggerall = root,p2bodydist x > 70
triggerall = enemynear(root,var(53)),stateno >= 200
trigger1 = root,movetype = H
trigger1 = root,stateno = [120,159]
trigger1 = enemynear(root,var(53)),movetype = A
trigger1 = enemynear(root,var(53)),hitdefattr = SCA, NA, SA, HA
trigger1 = enemynear(root,var(53)),movecontact = 1
v = 12
value = ifelse(floor(root,p2bodydist x) > var(12), floor(root,p2bodydist x), var(12))
ignorehitpause = 1

;--------------------------------------------------------------------------
;総合攻撃時間判定

[State 25000, P2MoveType = A]
type = VarSet
triggerall = var(13) != 0
trigger1 = enemynear(root,var(53)),movetype != A
trigger2 = enemynear(root,var(53)),time = 1
trigger2 = enemynear(root,var(53)),stateno >= 200
trigger2 = enemynear(root,var(53)),prevstateno >= 200
trigger2 = enemynear(root,var(53)),prevstateno != enemynear(root,var(53)),stateno
trigger2 = enemynear(root,var(53)),prevstateno + 1 != enemynear(root,var(53)),stateno
trigger2 = enemynear(root,var(53)),prevstateno + 2 != enemynear(root,var(53)),stateno
trigger3 = enemynear(root,var(53)),time = 1
trigger3 = enemynear(root,var(53)),stateno >= 200
trigger3 = enemynear(root,var(53)),prevstateno >= 200
trigger3 = enemynear(root,var(53)),prevstateno = enemynear(root,var(53)),stateno
v = 13
value = 0
ignorehitpause = 1

[State 25000, P2MoveType = A]
type = VarAdd
trigger1 = enemynear(root,var(53)),movetype = A
v = 13
value = 1
ignorehitpause = 1

;--------------------------------------------------------------------------
;自分ステート監視

[State 25000, StateNo]
type = VarSet
trigger1 = root,movetype = A
trigger1 = root,stateno >= 200
v = 14
value = root,stateno
ignorehitpause = 1

;---------------------------------------------------------------------------
;空対地攻撃範囲学習

[State 25000, P2BodyDist X_Air]
type = VarSet
triggerall = enemynear(root,var(53)),movetype = A
triggerall = enemynear(root,var(53)),statetype != A
triggerall = enemynear(root,var(53)),stateno >= 200
triggerall = enemynear(root,var(53)),hitdefattr = SCA, NA, SA, HA
triggerall = root,stateno = 5020 && time = 1
trigger1 = root,prevstateno = 50
trigger2 = root,prevstateno = 132
trigger3 = root,prevstateno = [600,630]
v = 15
value = ifelse(floor(root,p2bodydist x) > var(15), floor(root,p2bodydist x), var(15))

[State 25000, P2BodyDist Y_Air]
type = VarSet
triggerall = enemynear(root,var(53)),movetype = A
triggerall = enemynear(root,var(53)),statetype != A
triggerall = enemynear(root,var(53)),stateno >= 200
triggerall = enemynear(root,var(53)),hitdefattr = SCA, NA, SA, HA
triggerall = root,stateno = 5020 && time = 1
trigger1 = root,prevstateno = 50
trigger2 = root,prevstateno = 132
trigger3 = root,prevstateno = [600,630]
v = 16
value = ifelse(floor(root,p2bodydist y) > var(16), floor(root,p2bodydist y), var(16))

